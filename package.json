{
  "name": "vestige",
  "version": "0.1.0",
  "description": "Browser-based JavaScript time-travel debugger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
