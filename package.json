    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/standalone": "^8.1.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
